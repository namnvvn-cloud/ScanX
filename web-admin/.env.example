# Địa chỉ backend NestJS (Render)
NEXT_PUBLIC_API_URL=https://scanx-450n.onrender.com

# Cấu hình Firebase Web App (Firebase Console → Project settings → Your apps → Web app "ScanX Web")
# Các giá trị này KHÔNG phải bí mật (giống google-services.json), được nhúng vào trình duyệt.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=scanx-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=scanx-app
NEXT_PUBLIC_FIREBASE_APP_ID=
