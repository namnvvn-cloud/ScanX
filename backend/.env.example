# === Supabase Postgres ===
# Project Settings → Database → Connection string → chọn "URI", chế độ Session hoặc Transaction pooler.
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# === Firebase Admin SDK ===
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Tải file .json về, mở ra, dán NGUYÊN VĂN nội dung (dạng JSON 1 dòng) vào giữa 2 dấu nháy đơn.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# === Storage (Supabase Storage, S3-compatible — free, không cần thẻ) ===
# Supabase Dashboard → Storage → New bucket (tên "scanx-documents", KHÔNG bật Public)
# rồi Project Settings → Storage → mục "S3 Connection" → New access key.
# Endpoint/Region lấy đúng giá trị hiển thị trong mục "S3 Connection" đó (region KHÔNG phải "auto").
STORAGE_ENDPOINT="https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3"
STORAGE_REGION="ap-southeast-1"
STORAGE_BUCKET="scanx-documents"
STORAGE_ACCESS_KEY_ID="..."
STORAGE_SECRET_ACCESS_KEY="..."

# === Server ===
PORT=3000

# === Phase 2: Web Admin + bán gói Business ===
# Email được vào trang quản trị (cách nhau dấu phẩy). Tài khoản phải đã xác minh email (Google login luôn đạt).
ADMIN_EMAILS="namnv.vn@gmail.com"
# URL công khai của chính backend — dùng làm IPN URL cho MoMo.
PUBLIC_API_URL="https://scanx-450n.onrender.com"
# Bỏ qua tự chạy migration khi khởi động (mặc định: tự chạy, an toàn vì mọi lệnh đều "if not exists").
# SKIP_MIGRATIONS=true

# VNPay — đăng ký sandbox: https://sandbox.vnpayment.vn/devreg/ → email gửi TMN code + Hash secret. BÍ MẬT.
# Bỏ trống = ẩn nút VNPay trên web.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
# VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"   # production: https://pay.vnpay.vn/vpcpay.html

# MoMo — thông tin test công khai trong tài liệu developers.momo.vn; production lấy trong MoMo Business. BÍ MẬT (secret key).
# Bỏ trống = ẩn nút MoMo trên web.
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
# MOMO_ENDPOINT="https://test-payment.momo.vn"   # production: https://payment.momo.vn
